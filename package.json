{
  "name": "settings-ui",
  "version": "2.3.9",
  "description": "Dashboard to manage settings API based on NextJs",
  "private": true,
  "scripts": {
    "dev": "cross-env ENV_FILE=envs/.env.development next dev --turbopack",
    "dev:staging": "cross-env ENV_FILE=envs/.env.staging next dev",
    "build:development": "cross-env ENV_FILE=envs/.env.development next build",
    "start:development": "cross-env ENV_FILE=envs/.env.development next start",
    "build:staging": "ENV_FILE=envs/.env.staging next build",
    "start:staging": "ENV_FILE=envs/.env.staging next start",
    "build:production": "ENV_FILE=envs/.env.production next build",
    "start:production": "ENV_FILE=envs/.env.production next start",
    "eslint": "eslint \"./**/*.{ts,tsx}\"",
    "eslint:fix": "eslint \"./**/*.{ts,tsx}\" --fix",
    "test": "jest",
    "post-update": "echo \"codesandbox preview only, need an update\" && yarn upgrade --latest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/system": "^9.0.1",
    "@mui/x-data-grid": "^9.1.0",
    "@rjsf/core": "^6.5.2",
    "@rjsf/mui": "^6.5.2",
    "@rjsf/utils": "^6.5.2",
    "@rjsf/validator-ajv8": "^6.5.2",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "ajv-errors": "^3.0.0",
    "dotenv": "^17.4.2",
    "lodash": "^4.18.1",
    "next": "^16.2.6",
    "npm-check-updates": "^22.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-intersection-observer": "^10.0.3",
    "sharp": "^0.34.5",
    "swr": "^2.4.1",
    "webpack-strip-code": "^1.0.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.14",
    "@typescript-eslint/parser": "^8.59.2",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "next-router-mock": "^1.0.5",
    "style-loader": "^4.0.0",
    "stylelint": "^17.11.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
